DROP DATABASE IF EXISTS itest;
CREATE DATABASE itest;
CREATE TABLE itest.t1 (id INT, name VARCHAR(20));
CREATE TABLE itest.t2 (id INT, tag VARCHAR(20));
INSERT INTO itest.t1 VALUES (1, 'a'), (2, 'b');
INSERT INTO itest.t2 VALUES (1, 'x'), (3, 'y');
SELECT t1.id, t1.name, t2.tag FROM itest.t1 JOIN itest.t2 ON t1.id = t2.id;
id	name	tag
1	a	x
SELECT t1.id, t2.tag FROM itest.t1 LEFT JOIN itest.t2 ON t1.id = t2.id ORDER BY t1.id;
id	tag
NULL	NULL
1	x
SELECT t1.id, t1.name, t2.tag FROM itest.t1 JOIN itest.t2 ON t1.id = t2.id WHERE t1.id = 1;
id	name	tag
1	a	x
SELECT t1.id, t2.tag FROM itest.t1 CROSS JOIN itest.t2 ORDER BY t1.id, t2.tag;
id	tag
1	x
1	x
3	y
3	y
SELECT t1.id, t2.tag FROM itest.t1, itest.t2 ORDER BY t1.id, t2.tag;
id	tag
1	x
1	x
3	y
3	y
CREATE TABLE itest.t3 (id INT, note VARCHAR(20));
INSERT INTO itest.t3 VALUES (1, 'n');
SELECT t1.id, t2.tag, t3.note FROM itest.t1 JOIN itest.t2 ON t1.id = t2.id JOIN itest.t3 ON t2.id = t3.id;
id	tag	note
1	x	n
SELECT * FROM itest.t1 WHERE EXISTS (SELECT 1 FROM itest.t2 WHERE t2.id = t1.id) ORDER BY id;
id	name
1	a
SELECT * FROM itest.t1 WHERE NOT EXISTS (SELECT 1 FROM itest.t2 WHERE t2.id = t1.id) ORDER BY id;
id	name
2	b
SELECT * FROM itest.t1 WHERE id IN (SELECT id FROM itest.t2) ORDER BY id;
id	name
1	a
SELECT * FROM itest.t1 WHERE id = ANY (SELECT id FROM itest.t2) ORDER BY id;
id	name
1	a
SELECT * FROM itest.t1 WHERE id = SOME (SELECT id FROM itest.t2) ORDER BY id;
id	name
1	a
SELECT * FROM itest.t1 WHERE id <> ALL (SELECT id FROM itest.t2) ORDER BY id;
id	name
2	b
SELECT * FROM itest.t1 WHERE id > ANY (SELECT id FROM itest.t2) ORDER BY id;
id	name
2	b
SELECT * FROM itest.t1 WHERE id > ALL (SELECT id FROM itest.t2) ORDER BY id;
id	name
SELECT * FROM (SELECT id, name FROM itest.t1 WHERE id = 1) d;
id	name
1	a
SELECT x FROM (SELECT 2) AS d(x);
x
2
SELECT * FROM (SELECT * FROM (SELECT id FROM itest.t1 WHERE id = 2) a) b;
id
2
SELECT id, (SELECT tag FROM itest.t2 WHERE t2.id = t1.id) FROM itest.t1 ORDER BY id;
id	(SELECT `tag` FROM `itest`.`t2` WHERE `t2`.`id` = `t1`.`id`)
1	x
2	y
SELECT (SELECT 1);
(SELECT 1)
1
SELECT (SELECT 1 UNION SELECT 1);
(SELECT 1 UNION SELECT 1)
1
SELECT 1 WHERE EXISTS (SELECT 2 UNION SELECT 3);
1
1
SELECT * FROM itest.t1 WHERE id IN (SELECT 1 UNION SELECT 2) ORDER BY id;
id	name
1	a
2	b
