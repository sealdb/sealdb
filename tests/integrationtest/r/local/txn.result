DROP DATABASE IF EXISTS itest;
CREATE DATABASE itest;
CREATE TABLE itest.t (id INT, name VARCHAR(20));
BEGIN;
INSERT INTO itest.t VALUES (1, 'a');
COMMIT;
SELECT * FROM itest.t;
id	name
1	a
BEGIN;
INSERT INTO itest.t VALUES (2, 'b');
ROLLBACK;
SELECT * FROM itest.t;
id	name
1	a
BEGIN;
INSERT INTO itest.t VALUES (2, 'b');
SAVEPOINT sp1;
INSERT INTO itest.t VALUES (3, 'c');
ROLLBACK TO sp1;
SELECT * FROM itest.t ORDER BY id;
id	name
1	a
2	b
RELEASE SAVEPOINT sp1;
COMMIT;
START TRANSACTION READ ONLY;
SELECT * FROM itest.t ORDER BY id;
id	name
1	a
2	b
ROLLBACK;
START TRANSACTION READ WRITE;
INSERT INTO itest.t VALUES (4, 'd');
COMMIT AND CHAIN;
INSERT INTO itest.t VALUES (5, 'e');
COMMIT;
SELECT * FROM itest.t ORDER BY id;
id	name
1	a
2	b
4	d
5	e
