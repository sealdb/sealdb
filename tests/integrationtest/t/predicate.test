CREATE DATABASE itest;
CREATE TABLE itest.t (id INT, name VARCHAR(20));
INSERT INTO itest.t VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, NULL);

SELECT * FROM itest.t WHERE id BETWEEN 2 AND 3 ORDER BY id;
SELECT * FROM itest.t WHERE name LIKE 'b%';
SELECT * FROM itest.t WHERE id IN (1, 3) ORDER BY id;
SELECT id FROM itest.t WHERE name IS NULL;
SELECT * FROM itest.t WHERE id > 1 AND name = 'c';
-- sorted_result
SELECT * FROM itest.t;
