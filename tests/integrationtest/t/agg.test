DROP DATABASE IF EXISTS itest;
CREATE DATABASE itest;
CREATE TABLE itest.t (id INT, name VARCHAR(20));
INSERT INTO itest.t VALUES (1, 'a'), (2, 'a'), (3, 'b');

SELECT COUNT(*) FROM itest.t;
SELECT name, COUNT(*) FROM itest.t GROUP BY name ORDER BY name;
SELECT name, COUNT(*) FROM itest.t GROUP BY name HAVING COUNT(*) > 1;
SELECT name FROM itest.t GROUP BY name HAVING COUNT(*) = 1;
SELECT COUNT(DISTINCT name) FROM itest.t;
CREATE TABLE itest.d (name VARCHAR(20), id INT);
INSERT INTO itest.d VALUES ('a', 1), ('a', 1), ('a', 2), ('b', 3);
SELECT SUM(DISTINCT id), AVG(DISTINCT id), MIN(DISTINCT id), MAX(DISTINCT id) FROM itest.d;
SELECT id, SUM(id) OVER (ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM itest.t ORDER BY id;
SELECT id, ROW_NUMBER() OVER w FROM itest.t WINDOW w AS (ORDER BY id) ORDER BY id;
