DROP DATABASE IF EXISTS itest;
CREATE DATABASE itest;
CREATE TABLE itest.t (id INT, name VARCHAR(20));
SELECT TABLE_NAME FROM information_schema.tables WHERE TABLE_SCHEMA = 'itest';
SELECT COLUMN_NAME FROM information_schema.columns WHERE TABLE_SCHEMA = 'itest' AND TABLE_NAME = 't' ORDER BY COLUMN_NAME;
SELECT SCHEMA_NAME FROM information_schema.schemata WHERE SCHEMA_NAME = 'itest';
SHOW CREATE DATABASE itest;
SHOW CREATE TABLE itest.t;
SHOW FULL COLUMNS FROM itest.t;
CREATE INDEX idx_name ON itest.t (name);
SELECT INDEX_NAME, COLUMN_NAME FROM information_schema.statistics WHERE TABLE_SCHEMA = 'itest' AND TABLE_NAME = 't';
SHOW INDEX FROM itest.t;
SELECT ENGINE FROM information_schema.engines;
SELECT CHARACTER_SET_NAME FROM information_schema.character_sets WHERE CHARACTER_SET_NAME = 'utf8mb4';
SELECT COLLATION_NAME FROM information_schema.collations WHERE COLLATION_NAME = 'utf8mb4_bin';
SELECT TABLE_NAME FROM information_schema.views;
CREATE TABLE itest.p (id INT) PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (MAXVALUE));
SELECT PARTITION_NAME FROM information_schema.partitions WHERE TABLE_SCHEMA = 'itest' AND TABLE_NAME = 'p' ORDER BY PARTITION_NAME;
