# Dual / projection / arithmetic
SELECT 1 AS n;
SELECT 1 + 2 AS n;
SELECT 1 AS a, 2 AS b;

# CREATE / INSERT / SELECT *
DROP DATABASE IF EXISTS itest;
CREATE DATABASE itest;
CREATE TABLE itest.t (id INT, name VARCHAR(20));
INSERT INTO itest.t VALUES (1, 'a'), (2, 'b');
SELECT * FROM itest.t ORDER BY id;
SELECT id AS i FROM itest.t WHERE id = 2;
SELECT name FROM itest.t ORDER BY id;
SELECT 1 AS n EXCEPT SELECT 2;
SELECT 1 AS n INTERSECT SELECT 1;
SELECT 1 AS n EXCEPT SELECT 1;
